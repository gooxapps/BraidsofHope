# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Neon PostgreSQL connection string (e.g. postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require).
# When unset in local preview, the app persists data to a local SQLite database under data/braidsofhope.db.
DATABASE_URL=

# BLOB_READ_WRITE_TOKEN: Vercel Blob storage token for media & logo uploads.
# When unset in local preview, uploaded media is saved under public/uploads/.
BLOB_READ_WRITE_TOKEN=

# ADMIN_BOOTSTRAP_PASSCODE: Optional server-side emergency Super Admin passcode.
# Leave unset during first run to claim the initial Super Administrator account in /admin/login.
ADMIN_BOOTSTRAP_PASSCODE=

# SESSION_SECRET: Recommended secret string for signing admin session tokens on Vercel.
SESSION_SECRET=

# ENABLE_ADVANCED_DONATIONS: Developer-controlled feature entitlement ("true" to unlock advanced donation processing).
ENABLE_ADVANCED_DONATIONS=false
